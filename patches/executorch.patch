+          !cold.key_codes.flags().row_contiguous || !cold.value_codes.flags().row_contiguous ||
+          !cold.key_scales.flags().row_contiguous || !cold.value_scales.flags().row_contiguous ||
+          !cold.key_biases.flags().row_contiguous || !cold.value_biases.flags().row_contiguous)
+        throw std::invalid_argument("install_cold_history: layer geometry/precision differs");
+    }
+    auto old_roots = storage_roots();
+    for (const auto& root : old_roots)
+      if (!root.is_available())
+        throw std::invalid_argument("install_cold_history: source must already be complete");
+    auto candidate = std::make_unique<PendingColdInstall>();
+    candidate->cold.reserve(layers.size());
+    for (auto& layer : layers) candidate->cold.emplace_back(std::move(layer));
+    candidate->keys.reserve(kpool_.size());
+    candidate->values.reserve(vpool_.size());
+    pending_cold_install_ = std::move(candidate);
+    auto copy_hot = [&](const Pool& source, int heads, int dim) {
+      Pool result(initial, hot_maximum, heads, dim, float16);
+      if (!hot_tokens) return result;
+      if (heads > std::numeric_limits<int>::max() / source.slots())
+        throw std::overflow_error("install_cold_history: source gather index overflow");
+      std::vector<int32_t> indices(size_t(heads) * size_t(hot_tokens));
+      for (int head = 0; head < heads; ++head)
+        for (int token = 0; token < hot_tokens; ++token)
+          indices[size_t(head) * size_t(hot_tokens) + size_t(token)] =
+              head * source.slots() + newly_cold_tokens + token;
+      const auto rows = take(reshape(source.read(0, source.slots(), s),
+                                    {heads * source.slots(), dim}, s),
+                             array(indices.data(), {int(indices.size())}, int32), 0, s);
+      result.write(0, hot_tokens, reshape(rows, {1, heads, hot_tokens, dim}, s), s);
+      return result;
+    };
+    for (size_t l = 0; l < kpool_.size(); ++l) {
+      const auto& geometry = config_.layers.size() == 1 ? config_.layers.front() : config_.layers[l];
+      pending_cold_install_->keys.push_back(copy_hot(kpool_[l], geometry.n_kv_heads, geometry.head_dim));
+      pending_cold_install_->values.push_back(copy_hot(vpool_[l], geometry.n_kv_heads, geometry.head_dim));
+    }
+    std::vector<Tensor> roots;
+    roots.reserve(8 * kpool_.size());
+    for (size_t l = 0; l < kpool_.size(); ++l) {
+      const auto& cold = *pending_cold_install_->cold[l];
+      roots.insert(roots.end(), {cold.key_codes, cold.key_scales, cold.key_biases, cold.value_codes, cold.value_scales, cold.value_biases});
+      pending_cold_install_->keys[l].append_storage(roots);
+      pending_cold_install_->values[l].append_storage(roots);
+    }
+    eval(roots);
+    std::unordered_set<const void*> old_buffers;
+    for (auto& root : old_roots) old_buffers.insert(root.buffer().raw_ptr());
+    for (auto& root : roots)
+      if (!root.is_available() || old_buffers.count(root.buffer().raw_ptr()))
+        throw std::runtime_error("install_cold_history: candidate incomplete or retains original pool");
+    if (length() != previous_length || allocation_capacity() != previous_maximum ||
+        cold_tokens_ != previous_cold_tokens)
+      throw std::runtime_error("install_cold_history: owner changed during conversion");
+    for (int committed : layer_lengths_)
+      if (committed != previous_length)
+        throw std::runtime_error("install_cold_history: layer changed during conversion");
+    // No allocations/device work after this publication point. Superseded
+    // cold roots and hot pools are destroyed below; temporary old_roots leases
+    // are also released here. The logical absolute position is unchanged.
+    kpool_.swap(pending_cold_install_->keys);
+    vpool_.swap(pending_cold_install_->values);
+    cold_layers_.swap(pending_cold_install_->cold);
+    cold_layer_count_ = config_.n_layers;
+    cold_tokens_ = cold_tokens;
+    std::fill(last_update_tokens_.begin(), last_update_tokens_.end(), 0);
+    std::fill(last_update_end_.begin(), last_update_end_.end(), 0);
+    pending_cold_install_.reset();
+    old_roots.clear();
+  }
+
+  // Explicit T1-only mapping. Returned AttendSpec contains only the hot suffix;
+  // callers must use cold_layer() and a compressed-attention implementation.
+  AttendSpec update_cold_and_fetch(int layer, const std::vector<int32_t>& positions,
+                                  const Tensor& k, const Tensor& v, StreamOrDevice s) {
+    if (layer < 0 || layer >= config_.n_layers || !has_cold_history(layer) || pending_cold_install_)
+      throw std::invalid_argument("update_cold_and_fetch: published cold history required");
+    const size_t l = size_t(layer);
+    const int layer_cold = layer_cold_prefix_length(layer);
+    const auto& geometry = config_.layers.size() == 1 ? config_.layers.front() : config_.layers[l];
+    const ::mlx::core::Shape shape{1, geometry.n_kv_heads, 1, geometry.head_dim};
+    if (positions.size() != 1 || positions[0] != layer_lengths_[l] ||
+        positions[0] < layer_cold || positions[0] >= allocation_capacity() ||
+        k.shape() != shape || v.shape() != shape ||
+        k.dtype() != ::mlx::core::float16 || v.dtype() != ::mlx::core::float16)
+      throw std::invalid_argument("update_cold_and_fetch: ordered FP16 T1 append required");
+    const int start = positions[0];
+    const auto absolute = cache::SequenceCache::plan(layer, start, 1);
+    if (!absolute) throw std::runtime_error("update_cold_and_fetch: absolute capacity exceeded");
+    const int physical = start - layer_cold;
+    kpool_[l].write(physical, 1, k, s);
+    vpool_[l].write(physical, 1, v, s);
+    Tensor keys = kpool_[l].read(0, physical + 1, s);
+    Tensor values = vpool_[l].read(0, physical + 1, s);
+    layer_lengths_[l] = start + 1;
+    last_update_tokens_[l] = 1;
+    last_update_end_[l] = start + 1;
+    cache::SequenceCache::commit(*absolute);
+    return AttendSpec{keys, values, AttendSpec::Mask::None, std::nullopt};
+  }
+
+  // Native-only dense layer append during a mixed publication. The ordinary
+  // MLXCache override and exported plan/commit continue to reject ANY cold
+  // layer. This bypass admits only an ordered FP16 T1 for a still-dense layer.
+  AttendSpec update_dense_t1_and_fetch(int layer, const std::vector<int32_t>& positions,
+                                      const Tensor& k, const Tensor& v, StreamOrDevice s) {
+    if (layer < 0 || layer >= config_.n_layers || pending_cold_install_ ||
+        !has_cold_history() || has_cold_history(layer) || attention_selection_)
+      throw std::invalid_argument("update_dense_t1_and_fetch: mixed history and dense layer required");
+    const size_t l = size_t(layer);
+    const auto& geometry = config_.layers.size() == 1 ? config_.layers.front() : config_.layers[l];
+    const ::mlx::core::Shape shape{1, geometry.n_kv_heads, 1, geometry.head_dim};
+    if (geometry.policy.kind != cache::LayerPolicy::Kind::Flat || geometry.policy.window != 0 ||
+        config_.kv_dtype != static_cast<int>(ScalarType::Half) ||
+        positions.size() != 1 || positions[0] != layer_lengths_[l] ||
+        positions[0] < 0 || positions[0] >= allocation_capacity() ||
+        k.shape() != shape || v.shape() != shape ||
+        k.dtype() != ::mlx::core::float16 || v.dtype() != ::mlx::core::float16)
+      throw std::invalid_argument("update_dense_t1_and_fetch: ordered full-history FP16 T1 required");
+    const int start = positions[0];
+    const auto absolute = cache::SequenceCache::plan(layer, start, 1);
+    if (!absolute) throw std::runtime_error("update_dense_t1_and_fetch: absolute capacity exceeded");
+    kpool_[l].write(start, 1, k, s);
+    vpool_[l].write(start, 1, v, s);
+    Tensor keys = kpool_[l].read(0, start + 1, s);
+    Tensor values = vpool_[l].read(0, start + 1, s);
+    layer_lengths_[l] = start + 1;
+    last_update_tokens_[l] = 1;
+    last_update_end_[l] = start + 1;
+    cache::SequenceCache::commit(*absolute);
+    return AttendSpec{keys, values, AttendSpec::Mask::None, std::nullopt};
+  }
+
+  uint64_t attention_selection_layer_calls() const { return attention_selection_layer_calls_; }
+  bool has_attention_selection() const { return bool(attention_selection_); }
+
+  // Owner-thread only, after previous work completes. Default remains gather.
+  void set_attention_selection_reuse(bool enabled) {
+    if (attention_selection_stats_.reuse_enabled == enabled) return;
+    clear_hot_attention();
+    attention_selection_stats_.reuse_enabled = enabled;
+  }
+
+  // Independent opt-in; effective only while ordinary hot reuse is enabled.
+  void set_attention_selection_delta_reuse(bool enabled) {
+    if (attention_selection_stats_.delta_reuse_enabled == enabled) return;
+    clear_hot_attention();
+    attention_selection_stats_.delta_reuse_enabled = enabled;
+  }
+
+  static const char* attention_selection_delta_layout() { return "stable_slots_canonical_patch_v2"; }
+
+  AttentionSelectionStats attention_selection_stats() const {
+    auto result = attention_selection_stats_;
+    for (const auto& hot : hot_attention_) {
+      if (!hot) continue;
+      ++result.hot_layers;
+      std::vector<Tensor> roots;
+      hot->keys.append_storage(roots);
+      hot->values.append_storage(roots);
+      for (const auto& root : roots) {
+        result.hot_payload_bytes += root.nbytes();
+        result.hot_live_bytes += root.nbytes() / size_t(root.shape(2)) * size_t(hot->count);
+      }
+    }
+    return result;
+  }
+
+  // Owner-thread publication only, between complete forwards. Epoch/proposal
+  // admission belongs to the mailbox owner; this cache validates storage and
+  // indices. The shared proposal must remain immutable after publication.
+  void set_attention_selection(std::shared_ptr<const cache::AttentionSelection> selection) {
+    if (!selection) {
+      attention_selection_.reset();
+      attention_indices_.reset();
+      clear_hot_attention();
+      return;
+    }
+    if (selection == attention_selection_) return;
+    if (!has_full_history_storage() || selection->covered_length <= 0 ||
+        selection->covered_length > length() ||
+        selection->valid_until_position < selection->covered_length ||
+        selection->valid_until_position > capacity())
+      throw std::invalid_argument("attention selection requires committed full history and valid coverage");
+    const int heads = config_.layers.front().n_kv_heads;
+    if (selection->positions_by_head.size() != size_t(heads))
+      throw std::invalid_argument("attention selection must cover every KV head");
+    for (const auto& layer : config_.layers) {
+      if (layer.n_kv_heads != heads)
+        throw std::invalid_argument("attention selection requires uniform KV head counts");
+    }
+    for (int committed : layer_lengths_) {
+      if (committed != length())
+        throw std::invalid_argument("attention selection publication requires a complete forward");
+    }
+    const size_t count = selection->positions_by_head.front().size();
+    if (!count || count > size_t(selection->covered_length))
+      throw std::invalid_argument("attention selection has an invalid per-head count");
+    for (const auto& positions : selection->positions_by_head) {
+      if (positions.size() != count)
+        throw std::invalid_argument("attention selection per-head counts differ");
+      int previous = -1;
+      for (int position : positions) {
+        if (position <= previous || position >= selection->covered_length)
+          throw std::invalid_argument("attention selection positions must be ordered covered history");
+        previous = position;
+      }
+    }
+    const bool keep_hot = attention_selection_stats_.reuse_enabled &&
+        attention_selection_stats_.delta_reuse_enabled && attention_selection_ &&
+        attention_selection_->request_epoch == selection->request_epoch &&
+        count < size_t(selection->covered_length);
+    // The old proposal may expire exactly before this replacement. Its stored
+    // KV remains valid until a rewrite/reset; expiry only disallows using that
+    // proposal for attention. An already-observed expiry clears hot normally.
+    attention_selection_ = std::move(selection);
+    attention_indices_.reset();
+    delta_plan_.reset();
+    initial_hot_layout_.reset();
+    if (!keep_hot) clear_hot_attention();
+  }
+
+  // A reversible attention view; never replaces or truncates the backing KV.
+  // Only the native T1 path calls this, after validating its full AttendSpec.
+  AttendSpec select_for_attention(int layer, const AttendSpec& full, StreamOrDevice s = {}) {
+    if (!attention_selection_ || !has_full_history_storage() || layer < 0 ||
+        layer >= config_.n_layers || full.kind != AttendSpec::Mask::None || full.mask)
+      return full;
+    const size_t l = size_t(layer);
+    const int end = last_update_end_[l];
+    if (last_update_tokens_[l] != 1 || end <= 0 || end > capacity() ||
+        end != layer_lengths_[l]) {
+      hot_attention_[l].reset();
+      return full;
+    }
+    const auto selection = attention_selection_;
+    const int current_position = end - 1;
+    if (current_position > selection->valid_until_position) {
+      set_attention_selection(nullptr);
+      return full;
+    }
+    const auto& geometry = config_.layers.size() == 1 ? config_.layers.front() : config_.layers[l];
+    const ::mlx::core::Shape expected{1, geometry.n_kv_heads, end, geometry.head_dim};
+    if (full.K.shape() != expected || full.V.shape() != expected ||
+        full.K.dtype() != full.V.dtype() || selection->covered_length <= 0 ||
+        selection->covered_length > current_position ||
+        selection->positions_by_head.size() != size_t(geometry.n_kv_heads)) {
+      hot_attention_[l].reset();
+      return full;
+    }
+    const size_t selected = selection->positions_by_head.front().size();
+    const int tail = end - selection->covered_length;
+    if (!selected || selected > size_t(selection->covered_length)) return full;
+    if (selected == size_t(selection->covered_length)) return full;
+    const int count = int(selected) + tail;
+    if (attention_selection_stats_.reuse_enabled && hot_attention_[l] &&
+        hot_attention_[l]->selection == selection &&
+        hot_attention_[l]->end >= end - 1 && hot_attention_[l]->end <= end) {
+      auto& hot = *hot_attention_[l];
+      const int added = end - hot.end;
+      if (added) {
+        const ::mlx::core::Shape start{0, 0, end - 1, 0};
+        const ::mlx::core::Shape stop{1, geometry.n_kv_heads, end, geometry.head_dim};
+        hot.keys.write(hot.count, 1, ::mlx::core::slice(full.K, start, stop, s), s);
+        hot.values.write(hot.count, 1, ::mlx::core::slice(full.V, start, stop, s), s);
+        hot.end = end;
+        hot.count = count;
+      }
+      AttendSpec view{hot.keys.read(0, count, s), hot.values.read(0, count, s),
+                      AttendSpec::Mask::None, std::nullopt};
+      ++attention_selection_stats_.reuse_layer_calls;
+      attention_selection_stats_.copied_elements +=
+          uint64_t(2) * geometry.n_kv_heads * added * geometry.head_dim;
+      attention_selection_stats_.canonical_read_elements +=
+          uint64_t(2) * geometry.n_kv_heads * added * geometry.head_dim;
+      ++attention_selection_layer_calls_;
+      return view;
+    }
+    const int maximum_end = int(std::min<int64_t>(allocation_capacity(),
+        int64_t(selection->valid_until_position) + 1));
+    const int maximum = int(selected) + maximum_end - selection->covered_length;
+    if (attention_selection_stats_.reuse_enabled && attention_selection_stats_.delta_reuse_enabled &&
+        hot_attention_[l] && hot_attention_[l]->layout && hot_attention_[l]->selection != selection &&
+        hot_attention_[l]->selection->request_epoch == selection->request_epoch &&
+        hot_attention_[l]->end <= end && hot_attention_[l]->keys.slots() >= maximum &&
+        hot_attention_[l]->values.slots() >= maximum) {
+      auto& hot = *hot_attention_[l];
+      if (!delta_plan_ || delta_plan_->source != hot.layout ||
+          delta_plan_->source_end != hot.end || delta_plan_->end != end)
+        delta_plan_ = make_delta_plan(hot, *selection, end);
+      const auto& plan = *delta_plan_;
+      auto patch = [&](Pool& pool, const Tensor& canonical) {
+        if (!plan.destinations) return;
+        // Even relocated survivors are read from canonical KV. Gathering from
+        // the old hot root would retain its buffer through GPU completion and
+        // can prevent donation to the following same-shape scatter.
+        Tensor rows = ::mlx::core::gather(canonical,
+            {*plan.heads, *plan.positions}, {1, 2}, {1, 1, 1, geometry.head_dim}, s);
+        pool.write_head_cells(*plan.destinations, rows, s);
+      };
+      patch(hot.keys, full.K); patch(hot.values, full.V);
+      hot.selection = selection; hot.layout = plan.destination; hot.end = end; hot.count = count;
+      AttendSpec view{hot.keys.read(0, count, s), hot.values.read(0, count, s),
+                      AttendSpec::Mask::None, std::nullopt};
+      ++attention_selection_stats_.delta_layer_calls;
+      attention_selection_stats_.canonical_read_elements += uint64_t(2) * plan.rows * geometry.head_dim;
+      attention_selection_stats_.copied_elements += uint64_t(2) * plan.rows * geometry.head_dim;
+      ++attention_selection_layer_calls_;
+      return view;
+    }
+    // One immutable index array per T1 position, shared by all model layers.
+    if (!attention_indices_ || attention_indices_end_ != end) {
+      std::vector<int32_t> positions;
+      positions.reserve(size_t(geometry.n_kv_heads) * size_t(count));
+      for (const auto& head : selection->positions_by_head) {
+        if (head.size() != selected) return full;
+        int previous = -1;
+        for (int position : head) {
+          if (position <= previous || position >= selection->covered_length) return full;
+          positions.push_back(position);
+          previous = position;
+        }
+        for (int position = selection->covered_length; position < end; ++position)
+          positions.push_back(position);
+      }
+      attention_indices_ = Tensor(positions.data(), {1, geometry.n_kv_heads, count, 1}, ::mlx::core::int32);
+      attention_indices_end_ = end;
+    }
+    AttendSpec selected_view{
+        ::mlx::core::take_along_axis(full.K, *attention_indices_, 2, s),
+        ::mlx::core::take_along_axis(full.V, *attention_indices_, 2, s),
+        AttendSpec::Mask::None, std::nullopt};
+    if (attention_selection_stats_.reuse_enabled) {
+      // Bound the extra allocation to this proposal's remaining lifetime;
+      // preallocate it so each subsequent T1 does not grow/copy the hot prefix.
+      auto hot = std::make_unique<HotAttention>(maximum, geometry.n_kv_heads,
+                                               geometry.head_dim, full.K.dtype());
+      hot->keys.write(0, count, selected_view.K, s);
+      hot->values.write(0, count, selected_view.V, s);
+      hot->end = end;
+      hot->count = count;
+      hot->selection = selection;
+      if (attention_selection_stats_.delta_reuse_enabled) {
+        if (!initial_hot_layout_ || initial_hot_layout_->base_end != end) {
+          auto layout = std::make_shared<HotSlotLayout>();
+          layout->base_end = end;
+          layout->positions_by_head = selection->positions_by_head;
+          for (auto& head : layout->positions_by_head)
+            for (int position = selection->covered_length; position < end; ++position) head.push_back(position);
+          initial_hot_layout_ = std::move(layout);
+        }
+        hot->layout = initial_hot_layout_;
+      }
+      selected_view = AttendSpec{hot->keys.read(0, count, s), hot->values.read(0, count, s),
+                                 AttendSpec::Mask::None, std::nullopt};
+      hot_attention_[l] = std::move(hot);
+      ++attention_selection_stats_.rebuild_layer_calls;
+    }
+    ++attention_selection_stats_.gather_layer_calls;
+    attention_selection_stats_.copied_elements +=
+        uint64_t(2) * geometry.n_kv_heads * count * geometry.head_dim;
+    attention_selection_stats_.canonical_read_elements +=
+        uint64_t(2) * geometry.n_kv_heads * count * geometry.head_dim;
+    ++attention_selection_layer_calls_;
+    return selected_view;
+  }
+
+  int allocation_capacity() const {
+    return config_.allocation_capacity.value_or(config_.capacity);
+  }
+
+  void validate_request_allocation(std::optional<int> maximum) const {
+    if (!has_full_history_storage() ||
+        (maximum && (*maximum <= 0 || *maximum > config_.capacity))) {
+      throw std::invalid_argument("Request allocation requires full-history storage and a valid ceiling");
+    }
+  }
+
+  // The owner must synchronize before releasing pools. Keep this cache object:
+  // loaded delegates retain its address, not just its registry key.
+  void reset_request_allocation(std::optional<int> maximum) {
+    validate_request_allocation(maximum);
+    config_.allocation_capacity = maximum;
+    reset_storage();
+  }
+
+  void validate_prefix_allocation(int keep, std::optional<int> maximum) const {
+    validate_request_allocation(maximum);
+    const int next_maximum = maximum.value_or(config_.capacity);
+    if (pending_prefix_allocation_ || attention_selection_ || attention_indices_ ||
+        delta_plan_ || initial_hot_layout_ || keep < 0 || keep > length() ||
+        keep > next_maximum) {
+      throw std::invalid_argument("Prefix allocation requires idle dense full history and a valid prefix");
+    }
+    for (size_t layer = 0; layer < kpool_.size(); ++layer) {
+      if (layer_lengths_[layer] != length() || hot_attention_[layer] ||
+          kpool_[layer].slots() != vpool_[layer].slots() ||
+          kpool_[layer].max_slots() != allocation_capacity() ||
+          vpool_[layer].max_slots() != allocation_capacity() ||
+          kpool_[layer].slots() < length()) {
+        throw std::invalid_argument("Prefix allocation requires every layer's completed history");
+      }
+    }
+    for (const auto& root : storage_roots()) {
+      if (!root.is_available()) {
+        throw std::invalid_argument("Prefix allocation requires prior storage completion");
+      }
+    }
+  }
+
+  // Caller has drained and serialized the owner. Keep this cache object's
+  // address and original logical/RoPE capacity. Candidate pools remain owned
+  // if construction/evaluation fails so the owner can quarantine them.
+  void retain_prefix_allocation(int keep, std::optional<int> maximum, StreamOrDevice s = {}) {
+    validate_prefix_allocation(keep, maximum);
+    const int previous_length = length();
+    const auto previous_maximum = config_.allocation_capacity;
+    const int next_maximum = maximum.value_or(config_.capacity);
+    pending_prefix_allocation_ = std::make_unique<PendingPrefixAllocation>();
+    pending_prefix_allocation_->keys.reserve(kpool_.size());
+    pending_prefix_allocation_->values.reserve(vpool_.size());
+    bool copied = false;
+    for (size_t layer = 0; layer < kpool_.size(); ++layer) {
+      copied = copied || (keep > 0 && kpool_[layer].slots() > next_maximum);
+      pending_prefix_allocation_->keys.push_back(kpool_[layer].prefix_allocation(keep, next_maximum, s));
+      pending_prefix_allocation_->values.push_back(vpool_[layer].prefix_allocation(keep, next_maximum, s));
+    }
+    if (copied) {
+      std::vector<Tensor> roots;
+      roots.reserve(2 * kpool_.size());
+      for (size_t layer = 0; layer < kpool_.size(); ++layer) {
+        pending_prefix_allocation_->keys[layer].append_storage(roots);
+        pending_prefix_allocation_->values[layer].append_storage(roots);
+      }
+      ::mlx::core::eval(roots);
+    }
+    if (length() != previous_length || config_.allocation_capacity != previous_maximum ||
+        !cache::SequenceCache::rewind(keep)) {
+      throw std::runtime_error("Prefix allocation changed during preparation");
+    }
+    // All admission and device work precede publication; these swaps/fills
+    // allocate nothing. This is contiguous full history, never compaction.
+    kpool_.swap(pending_prefix_allocation_->keys);
+    vpool_.swap(pending_prefix_allocation_->values);
+    config_.allocation_capacity = maximum;
+    std::fill(layer_lengths_.begin(), layer_lengths_.end(), keep);
+    std::fill(last_update_tokens_.begin(), last_update_tokens_.end(), 0);
+    std::fill(last_update_end_.begin(), last_update_end_.end(), 0);
+    pending_prefix_allocation_.reset();
+  }
+
+  bool can_extend(int n = 1) const override {
+    const int maximum = allocation_capacity();
+    return n >= 0 && length() <= maximum && n <= maximum - length();
+  }
+
+  // Tensor-free admission for a native partial prefill. A ring that has not
+  // wrapped yet still is not a full-history owner. Default native T1 retains
+  // its separately admitted retained-history behavior.
+  bool has_full_history_storage() const {
+    if (has_cold_history() || pending_cold_install_ || retained_layout_.compacted() ||
+        pending_compaction_ || pending_prefix_allocation_) return false;
+    for (const auto& layer : config_.layers) {
+      if (layer.policy.kind != cache::LayerPolicy::Kind::Flat || layer.policy.window != 0)
