+    const size_t per_layer = count / static_cast<size_t>(state.layers);
+    for (size_t layer = 0; layer < kpool_.size(); ++layer) {
+      if (kpool_[layer].slots() < committed_length || vpool_[layer].slots() < committed_length) {
+        throw std::runtime_error("export_flat_fp32: committed prefix is not allocated in every layer");
+      }
