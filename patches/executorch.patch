+  // A compressed prefix is a different attention history. Rewinding it would
+  // require a separately specified retention/rollback policy, so only a no-op
+  // is allowed. Existing full-history and ring rollback retain their behavior.
+  bool rewind(int new_len) override {
+    if (has_cold_history() || pending_cold_install_) return false;
+    if (has_compacted_history()) return new_len == length();
+    if (!cache::SequenceCache::rewind(new_len)) return false;
+    set_attention_selection(nullptr);
+    std::fill(last_update_tokens_.begin(), last_update_tokens_.end(), 0);
+    std::fill(layer_lengths_.begin(), layer_lengths_.end(), new_len);
+    return true;
+  }
+
+  void clear() override {
+    if (has_cold_history() || pending_cold_install_) { reset_storage(); return; }
+    set_attention_selection(nullptr);
+    std::fill(last_update_tokens_.begin(), last_update_tokens_.end(), 0);
+    if (has_compacted_history()) { reset_storage(); return; }
