+struct KVAddressSnapshot {
+  std::vector<std::uintptr_t> addresses;
+  size_t incomplete = 0;
+};
+
+// Caller holds mlx_global_mutex(). Read only completed canonical K/V roots;
+// is_available() does not submit or wait. On Metal, data<void>() just obtains
+// the shared buffer's contents address, without reading its payload. Only
+// integers escape this helper: the temporary array references must be gone
+// before native graph construction, or this diagnostic could inhibit donation.
+KVAddressSnapshot snapshot_kv_addresses_locked(
+    const MLXSequenceCache& cache, size_t expected_roots) {
+  KVAddressSnapshot snapshot;
+  snapshot.addresses.resize(expected_roots, 0);
+  const auto roots = cache.storage_roots(); // Layer order: K0, V0, K1, V1, ...
+  if (roots.size() == expected_roots) {
+    for (size_t i = 0; i < roots.size(); ++i) {
+      if (roots[i].is_available()) {
+        snapshot.addresses[i] = reinterpret_cast<std::uintptr_t>(roots[i].data<void>());
+      }
+    }
+  }
+  // If a pool is unallocated, storage_roots omits it; do not guess which layer
+  // the remaining entries belong to. Count all slots as incomplete instead.
+  for (const auto address : snapshot.addresses) {
+    if (address == 0) ++snapshot.incomplete;
+  }
+  return snapshot;
+}
+
+void trace_kv_address_reuse(
+    const KVAddressSnapshot& before, const KVAddressSnapshot& after,
+    int stream, int position, size_t tokens) {
+  size_t matching = 0;
+  size_t incomplete = 0;
+  for (size_t i = 0; i < before.addresses.size(); ++i) {
+    const auto old_address = before.addresses[i];
+    const auto new_address = after.addresses[i];
+    if (old_address == 0 || new_address == 0) ++incomplete;
+    else if (old_address == new_address) ++matching;
+  }
+  // Address reuse only: neither a copy-byte counter nor proof that no copies
+  // occurred. Incomplete slots are excluded from matching, never read/waited.
+  std::fprintf(stderr,
+      "TRIFUSE_PREFILL_TIMING backend stage=greedy_kv_address_reuse "
+      "stream=%d position=%d tokens=%zu cache_only=0 matching=%zu total=%zu "
+      "incomplete=%zu before_incomplete=%zu after_incomplete=%zu\n",
+      stream, position, tokens, matching, before.addresses.size(), incomplete,
+      before.incomplete, after.incomplete);
+  std::fflush(stderr);
+}
