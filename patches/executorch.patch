+  std::optional<cache::SeqStepPlan> plan(int layer, int position, int T) const override {
+    // Generic exported planners must not treat absolute positions as compact
+    // slots. The native update path below performs its own explicit mapping.
+    if (has_cold_history() || pending_cold_install_ || has_compacted_history()) return std::nullopt;
+    const int maximum = allocation_capacity();
+    if (position < 0 || T < 0 || position > maximum || T > maximum - position)
+      return std::nullopt;
+    return cache::SequenceCache::plan(layer, position, T);
+  }
