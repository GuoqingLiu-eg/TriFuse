+  int retained_length(int layer) const {
+    if (layer < 0 || layer >= config_.n_layers)
+      throw std::out_of_range("retained_length: invalid layer");
+    return retained_layout_.retained_length(layer_lengths_[size_t(layer)]);
+  }
