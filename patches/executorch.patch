+namespace {
+// Only this payload holds MLX arrays. It is created/populated and destroyed
+// under mlx_global_mutex; GPU completion is waited outside that mutex.
+struct FeaturePayload {
+  FeatureBatch batch;
+  std::optional<array> summary;
+  ::mlx::core::Event completion;
+  bool submission_started = false;
+  bool sealed = false;
+  bool completion_known = false;
+  bool failed = false;
+};
+
+class SubmittedFeatureTicket final : public FeatureTicket {
+ public:
+  SubmittedFeatureTicket() : payload_(std::make_unique<FeaturePayload>()) {}
+  ~SubmittedFeatureTicket() override {
+    std::lock_guard<std::mutex> lock(mlx_global_mutex());
+    if (payload_ && payload_->submission_started && !payload_->completion_known) {
+      const auto& event = payload_->completion;
+      const auto* error = event.load_error();
+      if (payload_->failed || !payload_->sealed ||
+          (event.valid() && (!event.is_signaled() || (error && error->valid())))) {
+        // No implicit GPU wait or unsafe release on queue abandonment/error.
+        // The surrounding resident owner separately retains its inputs/cache.
+        (void)payload_.release();
+        return;
+      }
+    }
+    payload_.reset();
+  }
+
+  // Producer-only methods: caller holds mlx_global_mutex until seal_locked.
+  void configure_locked(int start, int count, const ResidentFeatureConfig& config) {
+    payload_->batch.absolute_start = start;
+    payload_->batch.token_count = count;
+    payload_->batch.block_tokens = config.block_tokens;
+    payload_->batch.layers = config.layers;
+  }
+  std::optional<array>& summary_locked() { return payload_->summary; }
+  void begin_submission_locked() { payload_->submission_started = true; }
+  void seal_locked() {
+    if (!payload_->summary || !payload_->submission_started) {
+      throw std::runtime_error("resident features: missing submitted summary");
+    }
+    const auto& summary = *payload_->summary;
+    const auto& batch = payload_->batch;
+    const ::mlx::core::Shape shape{int(batch.layers.size()), batch.token_count / batch.block_tokens,
+                                    int(FeatureBatch::feature_count)};
+    if (summary.shape() != shape || summary.dtype() != ::mlx::core::float32 ||
+        !summary.flags().row_contiguous || summary.status() == array::Status::unscheduled) {
+      throw std::runtime_error("resident features: submitted summary ABI differs");
+    }
+    payload_->completion = summary.event();
+    if (!payload_->completion.valid() && summary.status() != array::Status::available) {
+      throw std::runtime_error("resident features: missing completion event");
+    }
+    payload_->sealed = true;
+  }
+
+  FeatureBatch wait_and_read() override {
+    std::lock_guard<std::mutex> reader_lock(reader_mutex_);
+    if (read_started_) throw std::runtime_error("resident features: ticket already consumed");
+    read_started_ = true;
+    try {
+      ::mlx::core::Event event;
+      {
+        std::lock_guard<std::mutex> lock(mlx_global_mutex());
+        if (!payload_->sealed) throw std::runtime_error("resident features: ticket not submitted");
+        event = payload_->completion;
+      }
+      // Event::wait checks asynchronous errors before/after waiting, even if
+      // already signaled. Do not rely on is_signaled alone as success proof.
+      if (event.valid()) event.wait();
+      std::lock_guard<std::mutex> lock(mlx_global_mutex());
+      auto& summary = *payload_->summary;
+      summary.wait(); // Event above completed; this only finalizes array state.
+      payload_->completion_known = true;
+      const float* data = summary.data<float>();
+      if (!data) throw std::runtime_error("resident features: missing FP32 summary bytes");
+      FeatureBatch result = payload_->batch;
+      result.values.assign(data, data + summary.size());
+      for (float value : result.values) {
+        if (!std::isfinite(value)) throw std::runtime_error("resident features: nonfinite summary");
+      }
+      payload_->summary.reset();
+      payload_->completion = ::mlx::core::Event{};
+      return result;
+    } catch (...) {
+      // If completion itself failed, keep the submitted arrays alive. The
+      // worker must surface this error to its resident request, never retry it.
+      payload_->failed = true;
+      throw;
+    }
+  }
+
+ private:
+  std::unique_ptr<FeaturePayload> payload_;
+  std::mutex reader_mutex_;
+  bool read_started_ = false;
+};
+
+// Independent optional T1 teacher summary. No Q/K or unaggregated attention is
+// copied to the host. As with FeaturePayload, MLX array lifetimes are protected
+// by the global graph mutex while waiting occurs outside it.
+struct AttentionLabelPayload {
+  AttentionLabelBatch batch;
+  std::optional<array> summary;
+  ::mlx::core::Event completion;
+  bool submission_started = false;
+  bool sealed = false;
+  bool completion_known = false;
+  bool failed = false;
+};
+
+class SubmittedAttentionLabelTicket final : public AttentionLabelTicket {
+ public:
+  SubmittedAttentionLabelTicket() : payload_(std::make_unique<AttentionLabelPayload>()) {}
+  ~SubmittedAttentionLabelTicket() override {
+    std::lock_guard<std::mutex> lock(mlx_global_mutex());
+    if (payload_ && payload_->submission_started && !payload_->completion_known) {
+      const auto& event = payload_->completion;
+      const auto* error = event.load_error();
+      if (payload_->failed || !payload_->sealed ||
+          (event.valid() && (!event.is_signaled() || (error && error->valid())))) {
+        // Owner admission bounds outstanding tickets. An abandoned or failed
+        // submission must not trigger an implicit wait or unsafe graph release.
+        (void)payload_.release();
+        return;
+      }
+    }
+    payload_.reset();
+  }
+
+  void configure_locked(int query_position, const NativeLlamaPrefillConfig& geometry,
+                        const ResidentAttentionLabelConfig& config) {
+    config.validate_for(geometry.layers, 1);
+    if (query_position < 0 || query_position >= geometry.capacity ||
+        query_position == std::numeric_limits<int>::max())
+      throw std::runtime_error("resident attention labels: invalid absolute query position");
+    auto& batch = payload_->batch;
+    batch.query_position = query_position;
+    batch.covered_length = query_position + 1;
+    batch.full_length = query_position + 1;
+    batch.block_tokens = config.block_tokens;
+    batch.block_count = 1 + query_position / config.block_tokens;
+    batch.query_heads = geometry.query_heads;
+    batch.kv_heads = geometry.kv_heads;
+    batch.head_dim = geometry.head_dim;
+    batch.layers = config.layers;
+  }
+  std::optional<array>& summary_locked() { return payload_->summary; }
+  void begin_submission_locked() { payload_->submission_started = true; }
+  void seal_locked() {
+    if (!payload_->summary || !payload_->submission_started)
+      throw std::runtime_error("resident attention labels: missing submitted summary");
+    const auto& summary = *payload_->summary;
+    const auto& batch = payload_->batch;
+    const ::mlx::core::Shape expected{int(batch.layers.size()), batch.kv_heads, batch.block_count};
+    if (summary.shape() != expected || summary.dtype() != ::mlx::core::float32 ||
+        !summary.flags().row_contiguous || summary.status() == array::Status::unscheduled)
+      throw std::runtime_error("resident attention labels: submitted summary ABI differs");
+    payload_->completion = summary.event();
+    if (!payload_->completion.valid() && summary.status() != array::Status::available)
+      throw std::runtime_error("resident attention labels: missing completion event");
+    payload_->sealed = true;
+  }
+
+  AttentionLabelBatch wait_and_read() override {
+    std::lock_guard<std::mutex> reader_lock(reader_mutex_);
+    if (read_started_) throw std::runtime_error("resident attention labels: ticket already consumed");
+    read_started_ = true;
+    try {
+      ::mlx::core::Event event;
+      {
+        std::lock_guard<std::mutex> lock(mlx_global_mutex());
+        if (!payload_->sealed) throw std::runtime_error("resident attention labels: ticket not submitted");
+        event = payload_->completion;
+      }
+      if (event.valid()) event.wait(); // propagates asynchronous errors
+      std::lock_guard<std::mutex> lock(mlx_global_mutex());
+      auto& summary = *payload_->summary;
+      summary.wait(); // completed event; only finalizes array state
+      payload_->completion_known = true;
+      const float* data = summary.data<float>();
+      if (!data) throw std::runtime_error("resident attention labels: missing FP32 summary bytes");
+      AttentionLabelBatch result = payload_->batch;
+      result.values.assign(data, data + summary.size());
+      for (float value : result.values) {
+        if (!std::isfinite(value) || value < 0)
+          throw std::runtime_error("resident attention labels: invalid block score");
+      }
+      payload_->summary.reset();
+      payload_->completion = ::mlx::core::Event{};
+      return result;
+    } catch (...) {
+      std::lock_guard<std::mutex> lock(mlx_global_mutex());
+      payload_->failed = true;
+      throw;
+    }
+  }
+
+ private:
+  std::unique_ptr<AttentionLabelPayload> payload_;
+  std::mutex reader_mutex_;
+  bool read_started_ = false;
+};
