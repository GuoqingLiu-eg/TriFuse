+ResidentMoEPolicyContext::ResidentMoEPolicyContext(MLXCache* cache) {
+  if (!cache) throw std::invalid_argument("MoE policy: null cache");
+  std::lock_guard<std::mutex> lock(mlx_global_mutex());
+  auto* sequence = dynamic_cast<MLXSequenceCache*>(cache);
+  if (!sequence || !sequence->has_full_history_storage() || sequence->has_attention_selection() ||
+      sequence->attention_selection_layer_calls() || !::mlx::core::is_available(::mlx::core::Device::gpu)) {
+    throw std::invalid_argument("MoE policy: full-history GPU cache required");
+  }
+  storage_ = std::make_unique<Storage>(cache);
+}
+ResidentMoEPolicyContext::~ResidentMoEPolicyContext() {
+  std::lock_guard<std::mutex> lock(mlx_global_mutex());
+  storage_.reset();
+}
+void ResidentMoEPolicyContext::synchronize() {
+  std::lock_guard<std::mutex> lock(mlx_global_mutex());
+  ::mlx::core::synchronize(storage_->stream);
+}
+ResidentMoEPolicyScope::ResidentMoEPolicyScope(std::shared_ptr<ResidentMoEPolicyContext> context)
+    : context_(std::move(context)) {
+  if (!context_ || resident_moe_policy_scope)
+    throw std::invalid_argument("MoE policy: null or nested scope");
+  resident_moe_policy_scope = this;
+}
+ResidentMoEPolicyScope::~ResidentMoEPolicyScope() {
+  resident_moe_policy_scope = nullptr;
+}
+ResidentMoEPolicyScope* ResidentMoEPolicyScope::current() {
+  return resident_moe_policy_scope;
+}
