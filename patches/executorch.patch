+enum class CPUBlasThreading { Default, Single, Multi };
+
+#if defined(ET_MLX_ENABLE_CPU) && ET_MLX_ENABLE_CPU
+const char* blas_threading_name(CPUBlasThreading policy) {
+  switch (policy) {
+    case CPUBlasThreading::Single:
+      return "single";
+    case CPUBlasThreading::Multi:
+      return "multi";
+    default:
+      return "default";
+  }
+}
+#endif
+
+CPUBlasThreading read_blas_threading(
+    BackendInitContext& context,
+    ::mlx::core::Device device) {
+  const auto spec =
+      context.get_runtime_spec<const char*>(kCPUBlasThreadingKey);
+  if (!spec.ok()) {
+    if (spec.error() == Error::NotFound) {
+      return CPUBlasThreading::Default;
+    }
+    throw std::invalid_argument("MLX cpu_blas_threading must be a string");
+  }
+  if (!(device == ::mlx::core::Device::cpu)) {
+    throw std::invalid_argument("MLX cpu_blas_threading requires device='cpu'");
+  }
+  const char* value = spec.get();
+  if (value && std::strcmp(value, "default") == 0) {
+    return CPUBlasThreading::Default;
+  }
+  if (value && std::strcmp(value, "single") == 0) {
+    return CPUBlasThreading::Single;
+  }
+  if (value && std::strcmp(value, "multi") == 0) {
+    return CPUBlasThreading::Multi;
+  }
+  throw std::invalid_argument(
+      "MLX cpu_blas_threading must be exactly 'default', 'single', or 'multi'");
+}
+
+void configure_cpu_blas(
+    const ::mlx::core::Stream& stream,
+    CPUBlasThreading policy) {
+#if defined(ET_MLX_ENABLE_CPU) && ET_MLX_ENABLE_CPU
+  if (__builtin_available(macOS 15.0, iOS 18.0, tvOS 18.0, watchOS 11.0, *)) {
+    struct Readback {
+      int setter_result{0};
+      bool setter_called{false};
+      bool completed{false};
+      int actual{-1};
+    };
+    auto result = std::make_shared<Readback>();
+    // Accelerate's policy is thread-local. CPU matmul dispatches on this same
+    // per-stream scheduler worker, not the thread that loads or executes ET.
+    ::mlx::core::scheduler::enqueue(stream, [result, policy]() {
+      if (policy != CPUBlasThreading::Default) {
+        result->setter_called = true;
+        result->setter_result = BLASSetThreading(
+            policy == CPUBlasThreading::Single
+                ? BLAS_THREADING_SINGLE_THREADED
+                : BLAS_THREADING_MULTI_THREADED);
+      }
+      result->actual = static_cast<int>(BLASGetThreading());
+      result->completed = true;
+    });
+    // Waits for a queue marker after the readback and checks worker errors.
+    // The task owns its result even if enqueue/synchronize throws.
+    ::mlx::core::synchronize(stream);
+    const int expected = policy == CPUBlasThreading::Single
+        ? static_cast<int>(BLAS_THREADING_SINGLE_THREADED)
+        : static_cast<int>(BLAS_THREADING_MULTI_THREADED);
+    const bool known =
+        result->actual == static_cast<int>(BLAS_THREADING_SINGLE_THREADED) ||
+        result->actual == static_cast<int>(BLAS_THREADING_MULTI_THREADED);
+    const bool verified = result->completed && result->setter_result == 0 &&
+        known && (policy == CPUBlasThreading::Default || result->actual == expected);
+    const char* progress = std::getenv("TRIFUSE_RESIDENT_PROGRESS");
+    if (progress && std::strcmp(progress, "1") == 0) {
+      std::printf(
+          "TRIFUSE_CPU_BLAS stream=%d requested=%s actual=%s "
+          "setter_called=%d setter_result=%d worker_readback_verified=%d\n",
+          stream.index,
+          blas_threading_name(policy),
+          !known ? "unknown" : (result->actual == static_cast<int>(
+              BLAS_THREADING_SINGLE_THREADED) ? "single" : "multi"),
+          result->setter_called,
+          result->setter_result,
+          verified);
+      std::fflush(stdout);
+    }
+    if (!verified) {
+      throw std::runtime_error("MLX CPU worker BLAS threading readback failed");
+    }
+    return;
+  }
+  if (policy != CPUBlasThreading::Default) {
+    throw std::runtime_error(
+        "MLX CPU BLAS threading requires macOS 15 / iOS 18 or newer");
+  }
+#else
+  (void)stream;
+  (void)policy;
+  throw std::runtime_error(
+      "MLX CPU BLAS options require EXECUTORCH_MLX_ENABLE_CPU=ON");
+#endif
+}
 
