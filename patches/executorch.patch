+  void commit(const cache::SeqStepPlan& step) override {
+    if (has_cold_history() || pending_cold_install_)
+      throw std::runtime_error("commit: cold storage requires explicit T1 append");
+    // Validate the absolute end before the neutral controller can advance it.
+    // Read runs are physical, but read_base_pos is an absolute position for
+    // both flat and ring layouts. Use a wide sum before narrowing in the base.
+    if (step.n_read < 0 || step.n_read > 2 || step.n_write < 0 || step.n_write > 2 ||
+        step.read_base_pos < 0)
+      throw std::runtime_error("commit: invalid sequence step");
+    int64_t end = step.read_base_pos;
+    for (int i = 0; i < step.n_read; ++i) {
+      if (step.read[i].start < 0 || step.read[i].len < 0)
+        throw std::runtime_error("commit: invalid read run");
+      end += step.read[i].len;
+    }
+    if (end > allocation_capacity())
+      throw std::runtime_error("commit: allocation ceiling exceeded");
+    for (int i = 0; i < step.n_write; ++i) {
+      if (step.write[i].start < 0 || step.write[i].len < 0 ||
+          (config_.allocation_capacity &&
+           static_cast<int64_t>(step.write[i].start) + step.write[i].len > allocation_capacity()))
+        throw std::runtime_error("commit: invalid write run");
+    }
+    cache::SequenceCache::commit(step);
+  }
