+void ResidentGreedyOutputScope::begin_invocation() {
+  // A repeated delegate call cannot expose the first call's successful result.
+  completed_ = false;
+  result_ = {};
+  if (invoked_) throw std::runtime_error("resident greedy: repeated delegate invocation");
+  invoked_ = true;
+}
+void ResidentGreedyOutputScope::finish(ResidentGreedyResult result) {
+  if (!invoked_ || completed_ || result.vocabulary != vocabulary_ ||
+      result.token < 0 || result.token >= vocabulary_) {
+    throw std::runtime_error("resident greedy: invalid completion result");
+  }
+  result_ = result;
+  completed_ = true;
+}
+void ResidentGreedyOutputScope::fail() noexcept {
+  completed_ = false;
+  result_ = {};
+}
+ResidentGreedyResult ResidentGreedyOutputScope::result() const {
+  if (!completed_) throw std::runtime_error("resident greedy: result not completed");
+  return result_;
+}
