+  // Pure admission; safe to call before marking a resident action dispatched.
+  void validate_compact_retained(const std::vector<int32_t>& positions) const {
+    if (has_cold_history() || pending_cold_install_)
+      throw std::runtime_error("compact_retained: cold representation is unsupported");
+    if (config_.allocation_capacity)
+      throw std::runtime_error("compact_retained: explicit allocation ceiling is unsupported");
+    if (pending_compaction_)
+      throw std::runtime_error("compact_retained: previous completion is unknown");
+    for (const auto& layer : config_.layers) {
+      if (layer.policy.kind != cache::LayerPolicy::Kind::Flat || layer.policy.window != 0)
+        throw std::runtime_error("compact_retained: flat storage is required");
+    }
+    (void)retained_layout_.prepare_compaction(positions, length(), layer_lengths_);
+    for (size_t layer = 0; layer < kpool_.size(); ++layer) {
+      const int live = retained_length(int(layer));
+      if (kpool_[layer].slots() < live || vpool_[layer].slots() < live)
+        throw std::runtime_error("compact_retained: committed bytes are unavailable");
+    }
+  }
+
+  // Caller serializes this operation against execution. Build and evaluate all
+  // new allocations before publishing any layer. Original RoPE coordinates and
+  // the absolute next-token position do not change. Old roots may still be held
+  // by an external reader or MLX's allocator; this does not promise RSS release.
+  void compact_retained(const std::vector<int32_t>& positions, StreamOrDevice s = {}) {
+    validate_compact_retained(positions);
+    auto plan = retained_layout_.prepare_compaction(positions, length(), layer_lengths_);
+    auto candidate = std::make_unique<PendingCompaction>();
+    candidate->keys.reserve(kpool_.size());
+    candidate->values.reserve(vpool_.size());
+    for (size_t layer = 0; layer < kpool_.size(); ++layer) {
+      candidate->keys.push_back(kpool_[layer].compact_copy(plan.source_slots(), plan.max_physical_slots(), s));
+      candidate->values.push_back(vpool_[layer].compact_copy(plan.source_slots(), plan.max_physical_slots(), s));
+    }
+    pending_compaction_ = std::move(candidate);
+    std::vector<Tensor> roots;
+    roots.reserve(2 * kpool_.size());
+    for (size_t layer = 0; layer < kpool_.size(); ++layer) {
+      pending_compaction_->keys[layer].append_storage(roots);
+      pending_compaction_->values[layer].append_storage(roots);
+    }
+    ::mlx::core::eval(roots);
+    if (!retained_layout_.can_publish(plan, layer_lengths_))
+      throw std::runtime_error("compact_retained: cache changed during preparation");
+    // No allocations or device work occur after this publication boundary.
+    if (!retained_layout_.publish(std::move(plan), layer_lengths_))
+      throw std::runtime_error("compact_retained: stale publication");
+    kpool_.swap(pending_compaction_->keys);
+    vpool_.swap(pending_compaction_->values);
+    set_attention_selection(nullptr);
+    pending_compaction_.reset();
+    pending_prefix_allocation_.reset();
+  }
