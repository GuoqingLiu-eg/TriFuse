+  FlatFP32State export_flat_fp32(int committed_length, StreamOrDevice s = {}) {
+    FlatFP32State state = flat_shape(committed_length);
+    if (committed_length != length()) {
+      throw std::runtime_error("export_flat_fp32: outer committed length differs from cache");
