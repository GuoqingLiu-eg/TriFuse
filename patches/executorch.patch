+struct ResidentGreedyTicket::Storage {
+  MLXCache* cache = nullptr;
+  int vocabulary = 0, next_position = 0, stream_index = -1;
+  std::optional<array> token;
+  ::mlx::core::Event completion;
+  std::shared_ptr<void> input_lease;
+  bool sealed = false;
+};
+ResidentGreedyTicket::ResidentGreedyTicket() : storage_(std::make_unique<Storage>()) {}
+ResidentGreedyTicket::~ResidentGreedyTicket() {
+  std::shared_ptr<void> lease;
+  {
+    std::lock_guard<std::mutex> lock(mlx_global_mutex());
+    lease = std::move(storage_->input_lease);
+    storage_.reset();
+  }
+}
+int64_t ResidentGreedyTicket::wait_token() const {
+  ::mlx::core::Event completion;
+  {
+    std::lock_guard<std::mutex> lock(mlx_global_mutex());
+    if (!storage_->sealed || !storage_->token) throw std::runtime_error("greedy ticket: unsubmitted prediction");
+    completion = storage_->completion;
+  }
+  if (completion.valid()) completion.wait();
+  std::lock_guard<std::mutex> lock(mlx_global_mutex());
+  storage_->token->wait();
+  const auto& token = *storage_->token;
+  if (token.dtype() != ::mlx::core::int64 || token.size() != 1 || !token.data<int64_t>())
+    throw std::runtime_error("greedy ticket: invalid scalar");
+  const int64_t value = *token.data<int64_t>();
+  if (value < 0 || value >= storage_->vocabulary)
+    throw std::runtime_error("greedy ticket: nonfinite logits or token outside vocabulary");
+  return value;
+}
+ResidentGreedySubmissionScope::ResidentGreedySubmissionScope(
+    MLXCache* cache, int vocabulary, int position,
+    std::shared_ptr<ResidentGreedyTicket> input, std::shared_ptr<void> input_lease, bool initial_prediction)
+    : cache_(cache), vocabulary_(vocabulary), position_(position),
+      initial_prediction_(initial_prediction), input_(std::move(input)),
+      output_(new ResidentGreedyTicket()), input_lease_(std::move(input_lease)) {
+  if (!cache_ || vocabulary_ <= 0 || position_ < 0 || !input_lease_ ||
+      (initial_prediction_ && input_) ||
+      resident_greedy_submission_scope || resident_greedy_output_scope)
+    throw std::invalid_argument("greedy submission: invalid/nested scope");
+  resident_greedy_submission_scope = this;
+}
+ResidentGreedySubmissionScope::~ResidentGreedySubmissionScope() {
+  resident_greedy_submission_scope = nullptr;
+}
+ResidentGreedySubmissionScope* ResidentGreedySubmissionScope::current() {
+  return resident_greedy_submission_scope;
+}
+std::shared_ptr<ResidentGreedyTicket> ResidentGreedySubmissionScope::submitted_ticket() const {
+  if (!invoked_ || !output_ || !output_->storage_->sealed)
+    throw std::runtime_error("greedy submission: missing submitted ticket");
+  return output_;
+}
+void clear_greedy_allocator_cache() {
+  std::lock_guard<std::mutex> lock(mlx_global_mutex());
+  ::mlx::core::clear_cache();
+}
+
+void drain_submitted_work() {
+  std::lock_guard<std::mutex> lock(mlx_global_mutex());
+  const auto streams = ::mlx::core::get_streams();
+  for (const auto& stream : streams) {
+    ::mlx::core::synchronize(stream);
+  }
+}
+
+IdleMemoryMaintenance reclaim_idle_memory(std::optional<size_t> cache_limit) {
+  const auto started = std::chrono::steady_clock::now();
+  std::lock_guard<std::mutex> lock(mlx_global_mutex());
+  const auto drain_started = std::chrono::steady_clock::now();
+  const auto streams = ::mlx::core::get_streams();
+  for (const auto& stream : streams) {
+    ::mlx::core::synchronize(stream);
+  }
+  IdleMemoryMaintenance result{};
+  result.drain_ms = std::chrono::duration<double, std::milli>(
+      std::chrono::steady_clock::now() - drain_started).count();
+  result.synchronized_streams = streams.size();
+  result.active_before = ::mlx::core::get_active_memory();
+  result.cached_before = ::mlx::core::get_cache_memory();
+  result.peak_before = ::mlx::core::get_peak_memory();
+  const auto reclaim_started = std::chrono::steady_clock::now();
+  try {
+    if (cache_limit) {
+      result.previous_cache_limit = ::mlx::core::set_cache_limit(*cache_limit);
+    }
+    ::mlx::core::clear_cache();
+    result.reclaim_ms = std::chrono::duration<double, std::milli>(
+        std::chrono::steady_clock::now() - reclaim_started).count();
+    result.active_after = ::mlx::core::get_active_memory();
+    result.cached_after = ::mlx::core::get_cache_memory();
+    result.peak_after = ::mlx::core::get_peak_memory();
+  } catch (...) {
+    if (result.previous_cache_limit) {
+      ::mlx::core::set_cache_limit(*result.previous_cache_limit);
+    }
+    throw;
+  }
+  result.wall_ms = std::chrono::duration<double, std::milli>(
+      std::chrono::steady_clock::now() - started).count();
+  return result;
+}
+
+size_t restore_idle_cache_limit(size_t limit) {
+  std::lock_guard<std::mutex> lock(mlx_global_mutex());
+  return ::mlx::core::set_cache_limit(limit);
+}
