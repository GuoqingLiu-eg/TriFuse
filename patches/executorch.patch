+  RetainedStorageStats storage_stats() const {
+    if (pending_cold_install_)
+      throw std::runtime_error("storage_stats: cold conversion completion is unknown");
+    RetainedStorageStats result{length(), retained_length(0), 0, 0};
+    result.logical_capacity = config_.capacity;
+    result.allocation_capacity = allocation_capacity();
+    result.allocated_slots_per_layer.reserve(kpool_.size());
+    result.max_slots_per_layer.reserve(kpool_.size());
+    result.cold_prefix_tokens_per_layer.reserve(kpool_.size());
+    for (int layer = 0; layer < config_.n_layers; ++layer) {
+      const size_t index = static_cast<size_t>(layer);
+      if (layer_lengths_[index] != length() || retained_length(layer) != result.retained_tokens ||
+          kpool_[index].slots() != vpool_[index].slots() ||
+          kpool_[index].max_slots() != vpool_[index].max_slots())
+        throw std::runtime_error("storage_stats: incomplete layer transaction");
+      result.allocated_slots_per_layer.push_back(kpool_[index].slots());
+      result.max_slots_per_layer.push_back(kpool_[index].max_slots());
+      result.cold_prefix_tokens_per_layer.push_back(layer_cold_prefix_length(layer));
+    }
+    std::unordered_set<const void*> buffers;
+    auto roots = storage_roots();
+    for (auto& root : roots) {
+      if (!root.is_available()) throw std::runtime_error("storage_stats: synchronize storage first");
+      result.payload_bytes += root.nbytes();
+      if (buffers.insert(root.buffer().raw_ptr()).second) result.buffer_bytes += root.buffer_size();
+    }
+    for (size_t l = 0; l < cold_layers_.size(); ++l) {
+      if (cold_layers_[l]) {
+        const auto& cold = *cold_layers_[l];
+        result.cold_payload_bytes += cold.key_codes.nbytes() + cold.key_scales.nbytes() +
+            cold.key_biases.nbytes() + cold.value_codes.nbytes() + cold.value_scales.nbytes() + cold.value_biases.nbytes();
+      } else if (config_.kv_dtype == static_cast<int>(ScalarType::Half)) {
+        // Only unconverted layers still own an original full FP16 pool.
+        // Converted layers own a new, independent hot suffix allocation.
+        std::vector<Tensor> dense;
+        kpool_[l].append_storage(dense);
+        vpool_[l].append_storage(dense);
+        for (const auto& root : dense) result.original_fp16_owner_bytes += root.nbytes();
+      }
+    }
+    if (has_cold_history())
+      result.hot_payload_bytes = result.payload_bytes - result.cold_payload_bytes;
+    return result;
+  }
