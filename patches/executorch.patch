+void validate_native_model_configuration(const NativeModelConfig& config) {
+  if (!is_native_moe_policy_architecture(config.architecture) &&
+      (config.quantization_layout != NativeQuantizationLayout::Uniform ||
+       config.num_experts != 0 || config.experts_per_token != 0 ||
+       config.embedding_multiplier != 1 || config.residual_multiplier != 1 ||
+       config.attention_multiplier != 1 || config.logits_scaling != 1)) {
+    throw std::runtime_error("MoE/scaling configuration is unsupported by this native architecture");
+  }
+  switch (config.architecture) {
+    case NativeModelArchitecture::StandardLlamaTied:
+      NativeLlamaPrefill::validate_config(config); break;
+    case NativeModelArchitecture::GPTNeoXParallel:
+      NativeNeoXPrefill::validate_config(config); break;
+    case NativeModelArchitecture::GraniteMoE:
+    case NativeModelArchitecture::OLMoE:
+      NativeGraniteMoEPrefill::validate_config(config); break;
+    default: throw std::runtime_error("unsupported native model architecture");
+  }
+}
