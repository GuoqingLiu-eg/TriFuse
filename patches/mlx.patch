diff --git a/CMakeLists.txt b/CMakeLists.txt
index feb7ce5..37b4e9a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -181,8 +181,7 @@ if(MLX_BUILD_METAL)
     add_compile_definitions(MLX_METAL_DEBUG)
   endif()
 
-  # Probe the macOS SDK only on Darwin. On iOS the caller selects the SDK, so
-  # version detection is deferred and the baseline Metal feature set is used.
+  # Probe the target SDK. Keep the host defaults on Darwin.
   if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
     # Get the host macOS version.
     execute_process(
@@ -221,6 +220,49 @@ if(MLX_BUILD_METAL)
       OUTPUT_VARIABLE MLX_METAL_VERSION
       OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
     message(STATUS "Metal version: ${MLX_METAL_VERSION}")
+  elseif(CMAKE_SYSTEM_NAME STREQUAL "iOS")
+    # Use the selected SDK, including an explicit SDK path from the toolchain.
+    set(_mlx_ios_sdk "${CMAKE_OSX_SYSROOT}")
+    if(_mlx_ios_sdk STREQUAL "")
+      if(PLATFORM MATCHES "^SIMULATOR")
+        set(_mlx_ios_sdk iphonesimulator)
+      else()
+        set(_mlx_ios_sdk iphoneos)
+      endif()
+    endif()
+    string(TOLOWER "${_mlx_ios_sdk}" _mlx_ios_sdk_lower)
+    if(_mlx_ios_sdk_lower MATCHES "iphonesimulator")
+      set(_mlx_ios_min_flag "-mios-simulator-version-min")
+    elseif(_mlx_ios_sdk_lower MATCHES "iphoneos")
+      set(_mlx_ios_min_flag "-mios-version-min")
+    else()
+      message(FATAL_ERROR "MLX iOS build requires an iPhone SDK: ${_mlx_ios_sdk}")
+    endif()
+    execute_process(
+      COMMAND xcrun --sdk "${_mlx_ios_sdk}" --show-sdk-version
+      OUTPUT_VARIABLE _mlx_ios_sdk_version
+      OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
+    # Existing feature guards use this name for the target SDK version.
+    set(MACOS_SDK_VERSION "${_mlx_ios_sdk_version}")
+    set(MLX_METAL_VERSION 0)
+    if(NOT CMAKE_OSX_DEPLOYMENT_TARGET STREQUAL "")
+      set(_mlx_metal_probe "${CMAKE_CURRENT_BINARY_DIR}/mlx_metal_version.metal")
+      file(WRITE "${_mlx_metal_probe}" "__METAL_VERSION__\n")
+      execute_process(
+        COMMAND xcrun --sdk "${_mlx_ios_sdk}" metal
+                "${_mlx_ios_min_flag}=${CMAKE_OSX_DEPLOYMENT_TARGET}"
+                -E -x metal -P "${_mlx_metal_probe}"
+        OUTPUT_VARIABLE MLX_METAL_VERSION
+        OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
+      # Metal may emit module-import pragmas before the final macro value.
+      string(REGEX MATCH "(^|[\r\n])[ \t]*([0-9]+)[ \t]*$"
+             _mlx_metal_version_line "${MLX_METAL_VERSION}")
+      if(_mlx_metal_version_line STREQUAL "")
+        message(FATAL_ERROR "Invalid iOS Metal version: ${MLX_METAL_VERSION}")
+      endif()
+      set(MLX_METAL_VERSION "${CMAKE_MATCH_2}")
+    endif()
+    message(STATUS "Building with iOS SDK ${_mlx_ios_sdk_version}; deployment ${CMAKE_OSX_DEPLOYMENT_TARGET}; Metal ${MLX_METAL_VERSION}")
   else()
     set(MLX_METAL_VERSION 0)
   endif()
diff --git a/mlx/backend/metal/device.cpp b/mlx/backend/metal/device.cpp
index 2f25f89..d560dce 100644
--- a/mlx/backend/metal/device.cpp
+++ b/mlx/backend/metal/device.cpp
@@ -220,8 +220,15 @@ MTL::Library* load_default_library(MTL::Device* device) {
     return lib;
   }
 
-  // Then try default.metallib in a SwiftPM bundle if we have one
-  std::tie(lib, error[2]) = load_swiftpm_library(device, "default");
+  // Then try the metallib in a SwiftPM bundle if we have one. The name is a
+  // build-time define because ExecuTorch ships one bundle holding a metallib per
+  // platform slice, so each slice's binary must ask for its own file rather than a
+  // single shared "default". Falls back to "default" for a plain MLX build.
+#ifndef MLX_SWIFTPM_METALLIB_NAME
+#define MLX_SWIFTPM_METALLIB_NAME "default"
+#endif
+  std::tie(lib, error[2]) =
+      load_swiftpm_library(device, MLX_SWIFTPM_METALLIB_NAME);
   if (lib) {
     return lib;
   }
